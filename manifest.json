{
  "name": "Handshake Job Tracker",
  "key": "REDACTED",
  "description": "Track your job applications from Handshake and automatically sync them to Google Sheets!",
  "version": "3",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "applylog128butbetter.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "oauth2": {
    "client_id": "292911840518-css6b0s7d0ul3f73o0lbshhcafgk4v54.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://sheets.googleapis.com/*"
  ]
}